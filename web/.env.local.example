# ─── SMS via YOUR phone (not Telnyx) ────────────────────────────
# SMS_PROVIDER picks where texts go:  telnyx (default) | textbee | httpsms | custom
# To send from your real number, install a gateway app on your Android phone and
# set the matching vars below, then point its "received SMS" webhook at:
#   https://alpha-ai-desk.vercel.app/api/sms-inbound?secret=YOUR_SECRET
SMS_PROVIDER=telnyx
SMS_INBOUND_SECRET=                 # any random string; also goes in the webhook URL above
# TextBee (textbee.dev):
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# httpSMS (httpsms.com):
HTTPSMS_API_KEY=
HTTPSMS_FROM=+1XXXXXXXXXX           # your phone's number
# Custom gateway (any JSON POST endpoint):
SMS_CUSTOM_URL=

